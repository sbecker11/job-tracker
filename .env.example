# Copy this file to `.env` (same directory) and fill in real values.
# `.env` is git-ignored and loaded automatically at startup via python-dotenv.

# Required for --llm-fallback, JD review, and reply drafts. A Cursor user
# API key, so Grok draws from the Ultra allowance. Create one at
# https://cursor.com/dashboard/integrations
#
# This can also come from the shared workspace-recruiting-automation/.env
# one level up (single copy for this repo and comms-migration). Only
# uncomment and set a value here to override that shared key (see
# job_tracker/__init__.py). An uncommented blank line blocks the fallback.
# CURSOR_API_KEY=  # pragma: allowlist secret

# Optional: override the Grok model. Unset means grok-4.7 at high effort
# and fast speed. A Claude / GPT / Composer id is rejected.
# JOB_TRACKER_LLM_MODEL=grok-4.7

# Required only for scripts/triage_imap_inbox.py (email/imap_reader.py) — a
# plain-IMAP mailbox (username/password, no OAuth), currently
# shawn.becker@spexture.com on Hostinger. Prefix must match --imap-prefix
# (default: SPEXTURE). Same shared-.env fallback as CURSOR_API_KEY above.
# Never paste the real password into chat/logs — set it directly in .env.
# SPEXTURE_IMAP_HOST=imap.hostinger.com
# SPEXTURE_IMAP_PORT=993
# SPEXTURE_IMAP_USER=shawn.becker@spexture.com
# SPEXTURE_IMAP_PASSWORD=  # pragma: allowlist secret
